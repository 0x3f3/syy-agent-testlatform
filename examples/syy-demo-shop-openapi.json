{
  "openapi": "3.0.3",
  "info": {
    "title": "SYY Demo Shop API",
    "version": "1.0.0",
    "description": "用于 SYY Agent 智能接口自动化测试平台导入验证的示例电商接口文档。覆盖认证、用户、商品、订单、参数校验、异常响应和分页查询。注意：该文档仅描述接口契约；除非另行部署对应 Demo API 服务，server 地址不会自动提供可调用的后端。"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "SYY 本地 Demo API；后端启动后可直接执行"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "健康检查"
    },
    {
      "name": "Auth",
      "description": "认证与令牌"
    },
    {
      "name": "Users",
      "description": "用户管理"
    },
    {
      "name": "Products",
      "description": "商品查询与管理"
    },
    {
      "name": "Orders",
      "description": "订单创建、查询与取消"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "健康检查",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "UP",
                  "service": "syy-demo-shop"
                }
              }
            }
          },
          "503": {
            "description": "服务不可用"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "用户登录",
        "operationId": "login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "tester",
                "password": "Passw0rd!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "accessToken": "demo-token-123",
                  "tokenType": "Bearer",
                  "expiresIn": 3600
                }
              }
            }
          },
          "400": {
            "description": "用户名或密码格式错误"
          },
          "401": {
            "description": "用户名或密码错误"
          },
          "429": {
            "description": "登录过于频繁"
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "分页查询用户",
        "operationId": "listUsers",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "页码，从 1 开始",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "每页数量，最大 100",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "按用户名或邮箱模糊查询",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "用户状态",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "DISABLED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPage"
                },
                "example": {
                  "page": 1,
                  "pageSize": 10,
                  "total": 2,
                  "items": [
                    {
                      "id": 1001,
                      "username": "tester",
                      "email": "tester@example.com",
                      "status": "ACTIVE"
                    },
                    {
                      "id": 1002,
                      "username": "qa_user",
                      "email": "qa@example.com",
                      "status": "DISABLED"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未认证或令牌无效"
          },
          "403": {
            "description": "无权访问"
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "创建用户",
        "operationId": "createUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              },
              "example": {
                "username": "new_tester",
                "email": "new_tester@example.com",
                "password": "Passw0rd!",
                "age": 25
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "example": {
                  "id": 1003,
                  "username": "new_tester",
                  "email": "new_tester@example.com",
                  "status": "ACTIVE"
                }
              }
            }
          },
          "400": {
            "description": "参数校验失败"
          },
          "409": {
            "description": "用户名或邮箱已存在"
          }
        }
      }
    },
    "/api/v1/users/{userId}": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "根据 ID 查询用户",
        "operationId": "getUserById",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "example": {
                  "id": 1001,
                  "username": "tester",
                  "email": "tester@example.com",
                  "status": "ACTIVE"
                }
              }
            }
          },
          "404": {
            "description": "用户不存在"
          }
        }
      },
      "put": {
        "tags": [
          "Users"
        ],
        "summary": "更新用户信息",
        "operationId": "updateUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              },
              "example": {
                "email": "updated@example.com",
                "age": 26
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                },
                "example": {
                  "id": 1001,
                  "username": "tester",
                  "email": "updated@example.com",
                  "status": "ACTIVE"
                }
              }
            }
          },
          "400": {
            "description": "参数校验失败"
          },
          "404": {
            "description": "用户不存在"
          }
        }
      },
      "delete": {
        "tags": [
          "Users"
        ],
        "summary": "删除用户",
        "operationId": "deleteUser",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "删除成功"
          },
          "404": {
            "description": "用户不存在"
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "分页查询商品",
        "operationId": "listProducts",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 30
            }
          },
          {
            "name": "minPrice",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "float",
              "minimum": 0
            }
          },
          {
            "name": "maxPrice",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "format": "float",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                },
                "example": {
                  "page": 1,
                  "pageSize": 10,
                  "total": 2,
                  "items": [
                    {
                      "id": 2001,
                      "name": "机械键盘",
                      "category": "电脑配件",
                      "price": 299.0,
                      "stock": 50,
                      "status": "ON_SALE"
                    },
                    {
                      "id": 2002,
                      "name": "无线鼠标",
                      "category": "电脑配件",
                      "price": 99.0,
                      "stock": 0,
                      "status": "OFF_SALE"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "分页或价格区间参数错误"
          }
        }
      }
    },
    "/api/v1/products/{productId}": {
      "get": {
        "tags": [
          "Products"
        ],
        "summary": "查询商品详情",
        "operationId": "getProductById",
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Product"
                },
                "example": {
                  "id": 2001,
                  "name": "机械键盘",
                  "category": "电脑配件",
                  "price": 299.0,
                  "stock": 50,
                  "status": "ON_SALE"
                }
              }
            }
          },
          "404": {
            "description": "商品不存在"
          }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "查询当前用户订单",
        "operationId": "listOrders",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "CREATED",
                "PAID",
                "CANCELLED",
                "COMPLETED"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                },
                "example": {
                  "page": 1,
                  "pageSize": 10,
                  "total": 1,
                  "items": [
                    {
                      "id": 3001,
                      "userId": 1001,
                      "status": "CREATED",
                      "totalAmount": 299.0
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "未认证或令牌无效"
          }
        }
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "创建订单",
        "operationId": "createOrder",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderRequest"
              },
              "example": {
                "items": [
                  {
                    "productId": 2001,
                    "quantity": 1
                  }
                ],
                "remark": "请尽快发货"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": 3002,
                  "userId": 1001,
                  "status": "CREATED",
                  "totalAmount": 299.0
                }
              }
            }
          },
          "400": {
            "description": "商品数量或参数错误"
          },
          "401": {
            "description": "未认证"
          },
          "409": {
            "description": "库存不足"
          }
        }
      }
    },
    "/api/v1/orders/{orderId}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "summary": "查询订单详情",
        "operationId": "getOrderById",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "查询成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": 3001,
                  "userId": 1001,
                  "status": "CREATED",
                  "totalAmount": 299.0
                }
              }
            }
          },
          "404": {
            "description": "订单不存在"
          },
          "403": {
            "description": "无权查看该订单"
          }
        }
      }
    },
    "/api/v1/orders/{orderId}/cancel": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "取消订单",
        "operationId": "cancelOrder",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelOrderRequest"
              },
              "example": {
                "reason": "用户主动取消"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "取消成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": 3001,
                  "userId": 1001,
                  "status": "CANCELLED",
                  "totalAmount": 299.0
                }
              }
            }
          },
          "404": {
            "description": "订单不存在"
          },
          "409": {
            "description": "当前订单状态不允许取消"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "使用登录接口返回的 accessToken。示例 token 仅为文档占位值。"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "UP"
          },
          "service": {
            "type": "string",
            "example": "syy-demo-shop"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "format": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED"
            ]
          },
          "age": {
            "type": "integer",
            "minimum": 0,
            "maximum": 150
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "username",
          "email",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "format": "password"
          },
          "age": {
            "type": "integer",
            "minimum": 0,
            "maximum": 150
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "age": {
            "type": "integer",
            "minimum": 0,
            "maximum": 150
          }
        }
      },
      "UserPage": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "price",
          "stock",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "double",
            "minimum": 0
          },
          "stock": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "ON_SALE",
              "OFF_SALE"
            ]
          }
        }
      },
      "ProductPage": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          }
        }
      },
      "OrderItemRequest": {
        "type": "object",
        "required": [
          "productId",
          "quantity"
        ],
        "properties": {
          "productId": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          }
        }
      },
      "CreateOrderRequest": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/OrderItemRequest"
            }
          },
          "remark": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "CancelOrderRequest": {
        "type": "object",
        "properties": {
